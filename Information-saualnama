<!DOCTYPE html>
<html lang="kk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Информатика бойынша сауалнама</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #101d42, #2864c5);
    color: white;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.container {
    background: white;
    color: #222;
    width: 100%;
    max-width: 600px;
    padding: 30px;
    border-radius: 20px;
    box-shadow: 0 10px 35px rgba(0,0,0,0.3);
}

h1 {
    text-align: center;
    color: #2155b5;
}

.subtitle {
    text-align: center;
    color: #666;
}

.progress {
    background: #ddd;
    height: 8px;
    border-radius: 10px;
    margin: 20px 0;
    overflow: hidden;
}

.progress-bar {
    background: #2864c5;
    height: 100%;
    width: 0%;
    transition: width 0.3s;
}

#question {
    font-size: 21px;
    margin: 25px 0;
}

.option {
    display: block;
    background: #f0f4ff;
    border: 2px solid #d9e3ff;
    padding: 14px;
    margin: 10px 0;
    border-radius: 10px;
    cursor: pointer;
    transition: 0.2s;
}

.option:hover {
    background: #dce7ff;
}

.option input {
    margin-right: 10px;
}

button {
    background: #2864c5;
    color: white;
    border: none;
    padding: 14px 20px;
    width: 100%;
    border-radius: 10px;
    font-size: 17px;
    cursor: pointer;
    margin-top: 15px;
}

button:hover {
    background: #17469b;
}

#result {
    text-align: center;
    font-size: 20px;
    font-weight: bold;
}

.hidden {
    display: none;
}

.small {
    font-size: 13px;
    color: #777;
    text-align: center;
    margin-top: 20px;
}
</style>
</head>

<body>

<div class="container">

    <h1>💻 Информатика</h1>

    <p class="subtitle">Біліміңді тексер! Сауалнамаға қатыс.</p>

    <div id="quiz">
        <div class="progress">
            <div class="progress-bar" id="progressBar"></div>
        </div>

        <p id="counter"></p>

        <h2 id="question"></h2>

        <div id="answers"></div>

        <button id="nextButton" onclick="nextQuestion()">
            Келесі сұрақ →
        </button>

        <p class="small">Әр дұрыс жауап үшін 1 ұпай беріледі.</p>
    </div>

    <div id="finish" class="hidden">
        <h2>🎉 Сауалнама аяқталды!</h2>
        <p id="result"></p>
        <p id="message"></p>
        <button onclick="restartQuiz()">Қайта өту ↻</button>
    </div>

</div>

<script>
const questions = [
    {
        question: "1. Компьютердің миы деп нені атайды?",
        answers: ["Монитор", "Процессор", "Пернетақта", "Тінтуір"],
        correct: 1
    },
    {
        question: "2. Ақпаратты енгізу құрылғысы қайсы?",
        answers: ["Монитор", "Принтер", "Пернетақта", "Динамик"],
        correct: 2
    },
    {
        question: "3. Интернет дегеніміз не?",
        answers: [
            "Компьютер ойыны",
            "Әлемдік компьютерлік желі",
            "Мәтіндік редактор",
            "Пернетақта түрі"
        ],
        correct: 1
    },
    {
        question: "4. Ақпараттың ең кіші өлшем бірлігі қандай?",
        answers: ["Байт", "Килобайт", "Бит", "Мегабайт"],
        correct: 2
    },
    {
        question: "5. Компьютер экраны қалай аталады?",
        answers: ["Монитор", "Принтер", "Сканер", "Модем"],
        correct: 0
    },
    {
        question: "6. Мәтін теруге арналған бағдарлама қайсы?",
        answers: ["Paint", "Microsoft Word", "Калькулятор", "Камера"],
        correct: 1
    },
    {
        question: "7. Файлдарды сақтауға не көмектеседі?",
        answers: ["Динамик", "Микрофон", "Жад құрылғысы", "Тінтуір"],
        correct: 2
    },
    {
        question: "8. Веб-сайттарды ашуға арналған бағдарлама қайсы?",
        answers: ["Google Chrome", "Paint", "Блокнот", "Калькулятор"],
        correct: 0
    },
    {
        question: "9. Пернетақтадағы Enter пернесі не үшін қолданылады?",
        answers: [
            "Дыбысты көтеру",
            "Растау немесе жаңа жолға өту",
            "Экранды тазалау",
            "Компьютерді жөндеу"
        ],
        correct: 1
    },
    {
        question: "10. Компьютерді вирустардан қорғауға не көмектеседі?",
        answers: [
            "Антивирус",
            "Калькулятор",
            "Монитор",
            "Принтер"
        ],
        correct: 0
    }
];

let currentQuestion = 0;
let score = 0;

function showQuestion() {
    const q = questions[currentQuestion];

    document.getElementById("counter").textContent =
        "Сұрақ " + (currentQuestion + 1) +
        " / " + questions.length;

    document.getElementById("question").textContent = q.question;

    document.getElementById("progressBar").style.width =
        (currentQuestion / questions.length * 100) + "%";

    const answersDiv = document.getElementById("answers");
    answersDiv.innerHTML = "";

    q.answers.forEach((answer, index) => {
        const label = document.createElement("label");
        label.className = "option";

        const radio = document.createElement("input");
        radio.type = "radio";
        radio.name = "answer";
        radio.value = index;

        label.appendChild(radio);
        label.appendChild(document.createTextNode(answer));

        answersDiv.appendChild(label);
    });

    document.getElementById("nextButton").textContent =
        currentQuestion === questions.length - 1
        ? "Нәтижені көру"
        : "Келесі сұрақ →";
}

function nextQuestion() {
    const selected = document.querySelector(
        'input[name="answer"]:checked'
    );

    if (!selected) {
        alert("Жауап нұсқасын таңда!");
        return;
    }

    if (Number(selected.value) ===
        questions[currentQuestion].correct) {
        score++;
    }

    currentQuestion++;

    if (currentQuestion < questions.length) {
        showQuestion();
    } else {
        showResult();
    }
}

function showResult() {
    document.getElementById("quiz").classList.add("hidden");
    document.getElementById("finish").classList.remove("hidden");

    document.getElementById("progressBar").style.width = "100%";

    document.getElementById("result").textContent =
        "Сенің нәтижең: " + score + " / " + questions.length;

    let message;

    if (score >= 9) {
        message = "Өте жақсы! Сен информатиканы жақсы білесің! 🏆";
    } else if (score >= 7) {
        message = "Жарайсың! Білімің жақсы! 👏";
    } else if (score >= 5) {
        message = "Жақсы! Тағы да дайындалып көр! 👍";
    } else {
        message = "Уайымдама! Қайталап оқып, тағы байқап көр! 📚";
    }

    document.getElementById("message").textContent = message;
}

function restartQuiz() {
    currentQuestion = 0;
    score = 0;

    document.getElementById("finish").classList.add("hidden");
    document.getElementById("quiz").classList.remove("hidden");

    showQuestion();
}

showQuestion();
</script>

</body>
</html>
